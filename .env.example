# =====================================================================
# Variáveis de ambiente — App de Pesquisa de Concorrentes
# Copie para .env.local em desenvolvimento. Em produção (Railway),
# cadastre-as em Service → Variables — nunca commitar .env.local.
#
# Banco: PostgreSQL simples, sem serviço externo (ex.: o Postgres do
# próprio Railway). Login sem senha, por código enviado ao e-mail (ou
# telefone + código para o agente de campo), com sessão guardada no banco.
# =====================================================================

# Connection string do PostgreSQL. No Railway, ao adicionar um serviço
# Postgres e referenciá-lo (${{Postgres.DATABASE_URL}}), esta variável é
# preenchida automaticamente — não precisa digitar à mão.
DATABASE_URL=postgres://usuario:senha@localhost:5432/pesquisa_concorrentes

# Segredo da aplicação (protege os códigos de acesso). SECRETO.
# Gere uma vez com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-e-longo

# Endereço público do sistema — usado no link do convite por e-mail.
APP_URL=https://seu-dominio.up.railway.app

# Envio de e-mail (convites e códigos de acesso) via Resend.
# Sem RESEND_API_KEY em desenvolvimento, o e-mail aparece só no log do
# servidor. Em produção é obrigatório.
RESEND_API_KEY=
# Só no ambiente de TESTE do Railway: 1 = não envia, imprime e-mails e códigos no log.
# NUNCA ligar em produção.
ENVIO_SIMULADO=
EMAIL_REMETENTE="Market Share Sousa Araujo <nao-responda@sousaaraujo.com.br>"

# Quantos dias a pessoa fica conectada sem pedir novo código (padrão: 7).
SESSAO_DIAS=7

# --- Bootstrap do primeiro Administrador (lido no deploy/migrate) ---
# Cria o primeiro usuário com perfil Administrador, se ainda não existir.
# Não há senha: ele entra em /entrar com o código enviado ao e-mail.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NOME="Administrador"

# --- Não configurar manualmente ---
# PORT é injetada automaticamente pelo Railway; `next start` já lê
# process.env.PORT nativamente.
